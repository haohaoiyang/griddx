TORCH_DEVICE=cpu
API_PORT=8000
# Host GPU selected by Docker Compose. Inside a one-GPU container, PyTorch uses index 0.
NVIDIA_GPU_ID=0
GPU_ID=0
MAX_SYNC_OBJECTS=10000
WORKER_POLL_SECONDS=2

# Full mode only. The final scheme and driver are confirmed during DB integration.
DATABASE_URL=
DB_TABLE_MAP={}
